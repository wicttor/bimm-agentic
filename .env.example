# Environment contract for the agent CLI (task 2026-09-04-001-T02).
# Copy to `.env` and fill in ONE key; `--env-file=.env` (Node >= 20.6) or your shell
# supplies them to the process. Never commit real keys.
#
# Set at least one of the three API keys below. If multiple are set, set LLM_PROVIDER to
# choose, or pass --provider on the CLI. With exactly one key set, the provider is
# auto-detected from whichever key is present.

# Anthropic (Claude) API key — required when the provider resolves to "anthropic".
ANTHROPIC_API_KEY=

# OpenAI API key — required when the provider resolves to "openai".
OPENAI_API_KEY=

# OpenRouter API key — required when the provider resolves to "openrouter".
# OpenRouter supports 200+ models; see https://openrouter.ai/models for pricing and availability.
OPENROUTER_API_KEY=

# Optional explicit provider choice: "anthropic" | "openai" | "openrouter".
# Overrides key auto-detection; an unknown value is rejected with the supported list.
LLM_PROVIDER=
